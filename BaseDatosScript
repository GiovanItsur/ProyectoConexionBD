create user 'Admin'@'%' identified by '12345root#';

Create Database Trabajadores;

use trabajadores;
create table usuarios (
    id_usuario INT PRIMARY KEY AUTO_INCREMENT,
    usuario VARCHAR(50) UNIQUE not null,
    contrasenia VARCHAR(255) not null,
    rol_sistema ENUM('ADMIN', 'EMPLEADO') DEFAULT 'EMPLEADO'
);
create table empleado(
	id_empleado INT PRIMARY KEY AUTO_INCREMENT,
    id_usuario int,
    nombre_empleado VARCHAR(50) NOT NULL,
    apellido_empleado VARCHAR(50) NOT NULL,
    genero VARCHAR(20) null,
    domicilio TEXT,
    estado_civil VARCHAR(30) not null,
    turno VARCHAR(30) not null,
    email VARCHAR(100) not null,
    rol_de_trabajo VARCHAR(50) not null,
    nacionalidad VARCHAR(50) not null,
    curp CHAR(18) not null,
    departamento VARCHAR(50) not null,
    rfc VARBINARY(255), 
    telefono VARBINARY(255),
    nss VARBINARY(255),
    FOREIGN KEY (id_usuario) REFERENCES usuarios(id_usuario) ON DELETE SET NULL
);


GRANT SELECT, UPDATE, DELETE, INSERT ON trabajadores.empleado TO 'Admin'@'%';
GRANT SELECT, UPDATE, DELETE, INSERT ON trabajadores.usuarios TO 'Admin'@'%';

